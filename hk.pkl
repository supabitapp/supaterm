amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

local function affectedProjectCheck(project: String): String =
  "repo_root=$(git rev-parse --show-toplevel)\n" +
  "cd \"$repo_root\"\n" +
  "[ -d apps/mac ] || exit 0\n" +
  "decision=$(python3 .github/scripts/affected_projects.py \(project)) || exit $?\n" +
  "[ \"$decision\" = run ] || exit 0"

local function affectedProjectStep(project: String, command: String): Step = new Step {
  check = "\(affectedProjectCheck(project))\n\(command)"
  stdin = "{{ hook_stdin }}"
  depends = "test-affected-projects"
}

hooks {
  ["pre-commit"] {
    steps {
      ["check-added-large-files"] = (Builtins.check_added_large_files) {
        check = "hk util check-added-large-files --maxkb 2048 {{ files }}"
      }
      ["check-case-conflict"] = Builtins.check_case_conflict
      ["check-merge-conflict"] = Builtins.check_merge_conflict
      ["detect-private-key"] = Builtins.detect_private_key
      ["vp-check"] = (Builtins.vp_check) {
        dir = "apps/supaterm.com"
        depends = "check-added-large-files"
      }
      ["swiftlint"] = (Builtins.swiftlint) {
        dir = "apps"
        depends = "check-added-large-files"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["git-lfs"] {
        check = "git lfs pre-push {{ hook_args }}"
        stdin = "{{ hook_stdin }}"
      }
      ["validate-submodule-branches"] {
        check = """
          repo_root=$(git rev-parse --show-toplevel)
          cd "$repo_root"
          python3 .github/scripts/validate_submodule_branches.py
          """
        stdin = "{{ hook_stdin }}"
        depends = "git-lfs"
      }
      ["validate-release-tags"] {
        check = """
          repo_root=$(git rev-parse --show-toplevel)
          cd "$repo_root"
          [ ! -d apps/mac ] || python3 .github/scripts/bump_and_release.py validate-pre-push
          """
        stdin = "{{ hook_stdin }}"
        depends = "validate-submodule-branches"
      }
      ["test-affected-projects"] {
        check = """
          repo_root=$(git rev-parse --show-toplevel)
          cd "$repo_root"
          python3 -m unittest discover -s .github/scripts -p '*_test.py'
          """
        depends = "validate-release-tags"
      }
      ["web-checks"] = affectedProjectStep(
        "web",
        "make web-install && make -j2 web-check web-test"
      )
      ["docs-checks"] = affectedProjectStep(
        "docs",
        "make docs-install docs-check docs-validate docs-build"
      )
      ["mac-checks"] = affectedProjectStep(
        "mac",
        "make mac-inspect-dependencies mac-scan-dead-code mac-test mac-test-e2e"
      )
      ["ios-checks"] = (affectedProjectStep("ios", "make ios-build")) {
        depends = "mac-checks"
      }
    }
  }
  ["post-checkout"] {
    steps {
      ["git-lfs"] {
        check = "git lfs post-checkout {{ hook_args }}"
      }
    }
  }
  ["post-merge"] {
    steps {
      ["git-lfs"] {
        check = "git lfs post-merge {{ hook_args }}"
      }
    }
  }
  ["post-commit"] {
    steps {
      ["git-lfs"] {
        check = "git lfs post-commit {{ hook_args }}"
      }
    }
  }
}
