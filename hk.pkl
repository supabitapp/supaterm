amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

local prePushMainCheck = """
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
[ -d apps/mac ] || exit 0
if ! awk 'NF && $3 == "refs/heads/main" { found = 1 } END { exit found ? 0 : 1 }'; then
  exit 0
fi
"""

hooks {
  ["pre-commit"] {
    steps {
      ["check-added-large-files"] = (Builtins.check_added_large_files) {
        check = "hk util check-added-large-files --maxkb 2048 {{ files }}"
      }
      ["check-case-conflict"] = Builtins.check_case_conflict
      ["check-merge-conflict"] = Builtins.check_merge_conflict
      ["detect-private-key"] = Builtins.detect_private_key
      ["vp-check"] = (Builtins.vp_check) {
        dir = "apps/supaterm.com"
        depends = "check-added-large-files"
      }
      ["swiftlint"] = (Builtins.swiftlint) {
        dir = "apps/mac"
        depends = "check-added-large-files"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["git-lfs"] {
        check = "git lfs pre-push {{ hook_args }}"
        stdin = "{{ hook_stdin }}"
      }
      ["validate-submodule-branches"] {
        check = """
          repo_root=$(git rev-parse --show-toplevel)
          cd "$repo_root"
          python3 .github/scripts/validate_submodule_branches.py
          """
        stdin = "{{ hook_stdin }}"
        depends = "git-lfs"
      }
      ["validate-release-tags"] {
        check = """
          repo_root=$(git rev-parse --show-toplevel)
          cd "$repo_root"
          [ ! -d apps/mac ] || python3 .github/scripts/bump_and_release.py validate-pre-push
          """
        stdin = "{{ hook_stdin }}"
        depends = "validate-submodule-branches"
      }
      ["web-install"] {
        check = "\(prePushMainCheck)\nmake web-install"
        stdin = "{{ hook_stdin }}"
        depends = "validate-release-tags"
      }
      ["web-check"] {
        check = "\(prePushMainCheck)\nmake web-check"
        stdin = "{{ hook_stdin }}"
        depends = "web-install"
      }
      ["web-test"] {
        check = "\(prePushMainCheck)\nmake web-test"
        stdin = "{{ hook_stdin }}"
        depends = "web-install"
      }
      ["docs-install"] {
        check = "\(prePushMainCheck)\nmake docs-install"
        stdin = "{{ hook_stdin }}"
        depends = "validate-release-tags"
      }
      ["docs-check"] {
        check = "\(prePushMainCheck)\nmake docs-check"
        stdin = "{{ hook_stdin }}"
        depends = "docs-install"
      }
      ["docs-validate"] {
        check = "\(prePushMainCheck)\nmake docs-validate"
        stdin = "{{ hook_stdin }}"
        depends = "docs-check"
      }
      ["docs-build"] {
        check = "\(prePushMainCheck)\nmake docs-build"
        stdin = "{{ hook_stdin }}"
        depends = "docs-validate"
      }
      ["mac-inspect-dependencies"] {
        check = "\(prePushMainCheck)\nmake mac-inspect-dependencies"
        stdin = "{{ hook_stdin }}"
        depends = "validate-release-tags"
      }
      ["mac-scan-dead-code"] {
        check = "\(prePushMainCheck)\nmake mac-scan-dead-code"
        stdin = "{{ hook_stdin }}"
        depends = "mac-inspect-dependencies"
      }
      ["mac-test"] {
        check = "\(prePushMainCheck)\nmake mac-test"
        stdin = "{{ hook_stdin }}"
        depends = "mac-scan-dead-code"
      }
      ["mac-test-e2e"] {
        check = "\(prePushMainCheck)\nmake mac-test-e2e"
        stdin = "{{ hook_stdin }}"
        depends = "mac-test"
      }
    }
  }
  ["post-checkout"] {
    steps {
      ["git-lfs"] {
        check = "git lfs post-checkout {{ hook_args }}"
      }
    }
  }
  ["post-merge"] {
    steps {
      ["git-lfs"] {
        check = "git lfs post-merge {{ hook_args }}"
      }
    }
  }
  ["post-commit"] {
    steps {
      ["git-lfs"] {
        check = "git lfs post-commit {{ hook_args }}"
      }
    }
  }
}
