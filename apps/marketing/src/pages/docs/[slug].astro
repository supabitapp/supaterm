---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { summarizeUserDoc } from "../../lib/docs";
import { GITHUB_REPOSITORY_URL } from "../../lib/site";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description } = summarizeUserDoc(entry.body ?? "");
const sections = headings.filter((heading) => heading.depth === 2);
const sourceUrl = `${GITHUB_REPOSITORY_URL}/blob/main/docs/user/${entry.id}.md`;
---

<Layout title={`${title} | Supaterm Docs`} description={description}>
  <div class="doc-page">
    <aside class="doc-nav" aria-label="On this page">
      <a class="doc-nav-back" href="/docs/"><span aria-hidden="true">&#8592;</span> All docs</a>
      {sections.length > 0 && (
        <>
          <p class="doc-nav-label">On this page</p>
          <ol>
            {sections.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </>
      )}
    </aside>
    <article class="doc-copy">
      <Content />
      <p class="doc-source"><a href={sourceUrl}>Edit this page on GitHub</a></p>
    </article>
  </div>
</Layout>

<style>
  .doc-page {
    display: grid;
    grid-template-columns: 210px minmax(0, 760px);
    gap: clamp(48px, 8vw, 120px);
    align-items: start;
    width: min(1120px, calc(100% - 64px));
    margin: 0 auto;
    padding: clamp(56px, 8vw, 104px) 0 112px;
  }

  .doc-nav {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 112px);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .doc-nav-back,
  .doc-nav-label {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .doc-nav-back:hover {
    color: var(--fg);
  }

  .doc-nav-label {
    margin-top: 36px;
  }

  .doc-nav ol {
    display: grid;
    gap: 2px;
    margin-top: 12px;
    list-style: none;
  }

  .doc-nav ol a {
    display: block;
    padding: 6px 0;
    color: var(--fg-dim);
    font-size: 0.78rem;
    line-height: 1.35;
    transition: color 0.16s ease;
  }

  .doc-nav ol a:hover {
    color: var(--fg);
  }

  .doc-copy {
    min-width: 0;
  }

  .doc-copy :global(h1) {
    margin-bottom: 28px;
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .doc-copy :global(h2) {
    margin: 64px 0 20px;
    padding-top: 48px;
    border-top: 1px solid var(--border);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .doc-copy :global(h3),
  .doc-copy :global(h4) {
    margin: 32px 0 10px;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .doc-copy :global(:is(h1, h2, h3, h4)) {
    scroll-margin-top: 96px;
  }

  .doc-copy :global(:is(p, li, td, th)) {
    color: var(--fg-muted);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .doc-copy :global(:is(p, pre, table, blockquote)) {
    margin: 16px 0;
  }

  .doc-copy :global(:is(ul, ol)) {
    display: grid;
    gap: 8px;
    margin: 16px 0;
    padding-left: 1.2rem;
  }

  .doc-copy :global(li::marker) {
    color: var(--accent);
  }

  .doc-copy :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }

  .doc-copy :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }

  .doc-copy :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .doc-copy :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
  }

  .doc-copy :global(:not(pre) > code) {
    padding: 0.12em 0.36em;
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--fg);
  }

  .doc-copy :global(pre) {
    overflow-x: auto;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .doc-copy :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .doc-copy :global(:is(td, th)) {
    padding: 8px 14px 8px 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .doc-copy :global(th) {
    color: var(--fg);
    font-weight: 600;
  }

  .doc-copy :global(blockquote) {
    padding-left: 16px;
    border-left: 2px solid var(--accent);
  }

  .doc-copy .doc-source {
    margin-top: 72px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  @media (max-width: 820px) {
    .doc-page {
      display: block;
      width: min(100% - 40px, 720px);
      padding-top: 40px;
      padding-bottom: 80px;
    }

    .doc-nav {
      position: static;
      margin-bottom: 32px;
    }

    .doc-nav-label,
    .doc-nav ol {
      display: none;
    }
  }
</style>
