---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { summarizeUserDoc } from "../../lib/docs";

const docs = (await getCollection("docs"))
  .map((entry) => ({ id: entry.id, ...summarizeUserDoc(entry.body ?? "") }))
  .toSorted((a, b) => a.title.localeCompare(b.title, "en", { sensitivity: "base" }));
---

<Layout
  title="Docs | Supaterm"
  description="Guides for installing Supaterm, connecting providers, working with threads, and reaching your agents remotely."
>
  <div class="docs-page">
    <header class="docs-hero">
      <p class="docs-eyebrow">Supaterm / Docs</p>
      <h1>Docs</h1>
    </header>
    <ul class="docs-index">
      {docs.map((doc) => (
        <li>
          <a href={`/docs/${doc.id}`}>
            <span class="docs-index-title">{doc.title}</span>
            <span class="docs-index-description">{doc.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .docs-page {
    width: min(1120px, calc(100% - 64px));
    margin: 0 auto;
    padding: clamp(72px, 10vw, 132px) 0 112px;
  }

  .docs-eyebrow {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .docs-hero h1 {
    margin-top: 18px;
    font-size: clamp(3.4rem, 8vw, 7.4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 0.9;
  }

  .docs-index {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1px;
    margin-top: 72px;
    border: 1px solid var(--border);
    background: var(--border);
    list-style: none;
  }

  .docs-index a {
    display: grid;
    align-content: start;
    gap: 8px;
    height: 100%;
    padding: 22px 24px;
    background: var(--bg);
    transition: background-color 0.16s ease;
  }

  .docs-index a:hover {
    background: color-mix(in srgb, var(--accent) 6%, var(--bg));
  }

  .docs-index-title {
    color: var(--fg);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .docs-index-description {
    display: -webkit-box;
    overflow: hidden;
    color: var(--fg-muted);
    font-size: 0.86rem;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  @media (max-width: 820px) {
    .docs-page {
      width: min(100% - 40px, 720px);
      padding-top: 56px;
      padding-bottom: 80px;
    }

    .docs-index {
      margin-top: 48px;
    }
  }
</style>
