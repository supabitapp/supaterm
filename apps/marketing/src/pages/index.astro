7.268l.003.003c.208.199.305.53.391.876.085.4.154.78.409 1.066.486.527.645.906.636 1.14l.003-.007v.018l-.003-.012c-.015.262-.185.396-.498.595-.63.401-1.746.712-2.457 1.57-.618.737-1.37 1.14-2.036 1.191-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69.176-.668.428-1.344.463-1.897.037-.714.076-1.335.195-1.814.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01c.053 0 .105.005.157.014.376.055.706.333 1.023.752l.91 1.664.003.003c.243.533.754 1.064 1.189 1.637.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294-.645.135-1.52.002-2.395-.464-.968-.536-2.118-.469-2.857-.602-.369-.066-.61-.2-.723-.4-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118-.055-.401-.083-.71.043-.94.16-.334.396-.4.69-.533.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838.19-.201.38-.336.663-.336zm7.159-9.074c-.435.201-.945.535-1.488.535-.542 0-.97-.267-1.28-.466-.154-.134-.28-.268-.373-.335-.164-.134-.144-.333-.074-.333.109.016.129.134.199.2.096.066.215.2.36.333.292.2.68.467 1.167.467.485 0 1.053-.267 1.398-.466.195-.135.445-.334.648-.467.156-.136.149-.267.279-.267.128.016.034.134-.147.332a8.097 8.097 0 01-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05.074-.043.18-.027.26.004.063 0 .16.067.15.135-.006.049-.085.066-.135.066-.055 0-.092-.043-.141-.068-.052-.018-.146-.008-.163-.065zm-.551 0c-.02.058-.113.049-.166.066-.047.025-.086.068-.14.068-.05 0-.13-.02-.136-.068-.01-.066.088-.133.15-.133.08-.031.184-.047.259-.005.019.009.036.03.03.05v.02h.003z"/></svg>
            <span id="download-label">Download for macOS</span>
          </a>
          <a class="btn btn-ghost btn-lg" href={IOS_TESTFLIGHT_URL} target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/></svg>
            <span>Join the iOS beta</span>
          </a>
        </div>
        <a class="hero-source-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
          <svg class="hero-source-mark" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
          </svg>
          <span>Open Source</span>
          <svg class="hero-source-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
        </a>
      </div>

      <!-- The rise wrapper is separate so its animated transform does not override the preview tilt. -->
      <div data-rise style="--d:520ms">
        <div class="hero-preview">
          <figure class="hero-screenshot-frame">
            <picture>
              <!-- Match the hidden mobile layout without requesting a screenshot. -->
              <source
                media="(max-width: 820px)"
                srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
              />
              <img
                src={desktopScreenshot.src}
                srcset={`${screenshot.srcSet.attribute}, ${desktopScreenshot.src} ${desktopScreenshot.width}w`}
                sizes="(max-width: 960px) min(864px, calc(100vw - 20px)), min(1180px, calc(100vw - 60px))"
                alt="Supaterm with an agent thread that opened a pull request, beside the diff of its latest turn"
                width={desktopScreenshot.width}
                height={desktopScreenshot.height}
                loading="eager"
                decoding="async"
              />
            </picture>
          </figure>
        </div>
      </div>

      <p class="hero-note">
        *Lumon Terminal Pro is the fictional computer from Severance. Supaterm is not affiliated with or endorsed by Apple.
      </p>
    </div>
  </section>

  <!-- ── Relay ─────────────────────────────────────────────────── -->
  <section id="relay" class="sec-relay">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Relay</div>
        <h2 class="display">End-to-end encrypted. No account needed.</h2>
        <p>No Tailscale/VPN setup required (although encouraged).</p>
      </div>

      <div
        class="relay-path"
        role="img"
        aria-label="A prompt is encrypted on your phone, crosses the relay as ciphertext, and is decrypted on your desktop."
      >
        <div class="relay-node">
          <div class="relay-node-head">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/></svg>
            <span>Your phone</span>
          </div>
          <code class="relay-payload">fix the flaky login test</code>
          <span class="relay-node-tag relay-node-tag--key">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>
            Encrypted on your phone
          </span>
        </div>

        <div class="relay-node">
          <span class="relay-hop"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          <div class="relay-node-head">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/></svg>
            <span class="relay-host">relay.supaterm.com</span>
          </div>
          <code class="relay-payload relay-payload--sealed">9f3ac1e0 7b44d21f 08e2</code>
          <span class="relay-node-tag">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.73 5.08A10.43 10.43 0 0112 5c7 0 10 7 10 7a13.16 13.16 0 01-1.67 2.68"/><path d="M6.61 6.61A13.53 13.53 0 002 12s3 7 10 7a9.74 9.74 0 005.39-1.61"/><path d="M14.12 14.12a3 3 0 11-4.24-4.24"/><path d="M2 2l20 20"/></svg>
            Never holds the keys or stores any data
          </span>
        </div>

        <div class="relay-node">
          <span class="relay-hop"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          <div class="relay-node-head">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            <span>Your desktop</span>
          </div>
          <code class="relay-payload">fix the flaky login test</code>
          <span class="relay-node-tag relay-node-tag--key">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 017.75-1.4"/></svg>
            Decrypted on your desktop
          </span>
        </div>
      </div>

      <div class="relay-footer">
        {[
          "Pairs with a one-time code. No sign-up.",
          "No open ports on your machine.",
          <Fragment><a href={RELAY_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Deploy your own relay</a>, or go direct over Tailscale or SSH.</Fragment>,
        ].map((point) => (
          <div class="relay-footer-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg> <span>{point}</span></div>
        ))}
        <span class="relay-spec">X25519 · ChaCha20-Poly1305</span>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";
  import { startHomeMotion } from "../lib/homeMotion";

  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Download for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  // Macs always get the arm64 build. Browsers cannot reliably tell Apple Silicon
  // from Intel (the UA lies, GPU strings lie), and a wrong guess hands an Apple
  // Silicon user a broken app. Intel users pick their build on /download.
  // Do NOT add arch detection back here.
  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      return assets.find((a) => a.name.endsWith("-arm64.dmg"))?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith("-x86_64.AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  async function init() {
    const btn = document.getElementById("download-btn") as HTMLAnchorElement | null;
    const label = document.getElementById("download-label");

    const platform = detectPlatform();
    if (!platform) return;
    document.documentElement.dataset.platform = platform.os;
    if (label) label.textContent = platform.label;

    try {
      const release = await fetchLatestRelease();
      const url = pickAsset(release.assets ?? [], platform);
      if (url && btn) {
        btn.href = url;
        btn.removeAttribute("target");
        btn.removeAttribute("rel");
      }
    } catch {
      if (btn) btn.href = RELEASES_URL;
    }
  }

  init();

  const hero = document.querySelector<HTMLElement>(".hero");
  const field = document.querySelector<HTMLElement>(".hero-float");
  if (hero && field) {
    startHomeMotion({ hero, field });
  }

  const crt = document.querySelector<HTMLElement>(".hero-crt");
  if (crt) {
    void import("../lib/crtModel").then(({ mountCrtModel }) => mountCrtModel(crt));
  }
</script>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    --crt-size: clamp(240px, 28vw, 380px);
    /* How far the model moves the CTA down: its height, less the 40px the headline's top margin gave up. */
    --crt-shift: calc(var(--crt-size) - 40px);
    padding: 72px 0 60px;
    position: relative;
    overflow: hidden;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
  }

  .hero-inner {
