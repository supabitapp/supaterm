---
import { Image } from "astro:assets";
import appIcon from "../assets/icon.webp";
import Layout from "../layouts/Layout.astro";
import "dialkit/vanilla/styles.css";
import "../styles/boltComputer.css";
import { BOLT_COMPUTER_STATES } from "../lib/boltComputer/faces";
import { STATE_COPY } from "../lib/studio";
---

<Layout
  title="Studio · Supaterm"
  description="Dress up the Supaterm bolt computer: pick its shell, its phosphor and what its screen shows."
>
  <section class="studio" data-studio>
    <div class="container">
      <div class="studio-grid">
        <div class="stage">
          <div class="stage-computer bolt-computer" data-stage>
            <Image
              src={appIcon}
              alt=""
              width={340}
              height={340}
              densities={[1, 2]}
              format="webp"
              quality={90}
              loading="eager"
            />
          </div>
          <div class="caption" aria-live="polite">
            <h2 data-caption-name>{STATE_COPY.idle.name}</h2>
            <p data-caption-hint>{STATE_COPY.idle.hint}</p>
          </div>
          <div class="screens" role="group" aria-label="Screen">
            {
              BOLT_COMPUTER_STATES.map((state) => (
                <button
                  type="button"
                  class="screen"
                  data-screen={state}
                  aria-pressed={state === "idle" ? "true" : "false"}
                >
                  <span class="screen-thumb bolt-computer" data-thumb={state} />
                  <span>{STATE_COPY[state].name}</span>
                </button>
              ))
            }
          </div>
        </div>

        <aside class="controls" aria-label="Controls">
          <div class="panel" data-panel></div>
          <div class="actions">
            <button type="button" class="btn btn-primary" data-action="download">Download PNG</button>
            <button type="button" class="btn btn-ghost" data-action="copy">Copy link</button>
            <button type="button" class="text-button" data-action="reset" hidden>Reset</button>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { startStudio } from "../lib/studio";

  const root = document.querySelector<HTMLElement>("[data-studio]");
  if (root) startStudio(root);
</script>

<style>
  .studio {
    padding: 32px 0 80px;
  }

  .studio-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 32px;
    align-items: start;
  }

  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 72px 24px 24px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: radial-gradient(ellipse 60% 50% at 50% 32%, rgba(255, 255, 255, 0.05), transparent 70%);
  }

  .stage-computer {
    width: clamp(220px, 26vw, 340px);
  }

  .stage-computer:global(.is-interactive) { cursor: pointer; }

  .caption {
    min-height: 56px;
    text-align: center;
  }

  .caption h2 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .caption p {
    margin-top: 4px;
    color: var(--fg-muted);
    font-size: 14px;
  }

  .screens {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    width: 100%;
    max-width: 520px;
  }

  .screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px 8px 8px;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--fg-muted);
    font-size: 13px;
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }

  .screen:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .screen[aria-pressed="true"] {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.04);
    color: var(--fg);
  }

  .screen-thumb {
    width: 48px;
  }

  .controls {
    position: sticky;
    top: 88px;
    overflow: clip;
    border: 1px solid var(--border);
    border-radius: 20px;
  }

  /* DialKit's copy button writes an agent prompt for editing its config, which a visitor has no use
     for. Copy link is how a look is shared. */
  .controls :global(.dialkit-toolbar-primary) {
    display: none;
  }

  .text-button {
    color: var(--fg-muted);
    font-size: 13px;
  }

  .text-button:hover { color: var(--fg); }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 16px;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 900px) {
    .studio-grid { grid-template-columns: 1fr; }
    .controls { position: static; }
  }

  @media (max-width: 520px) {
    .stage { padding: 72px 12px 20px; }
    .screens { gap: 6px; }
  }
</style>
