---
import { Image } from "astro:assets";
import appIcon from "../assets/icon.webp";
import Layout from "../layouts/Layout.astro";
import "../styles/boltComputer.css";
import { BOLT_COMPUTER_STATES } from "../lib/boltComputer/faces";
import {
  PHOSPHORS,
  SHELLS,
  SPEEDS,
  STATE_COPY,
  type ColourKey,
  type ControlKey,
} from "../lib/studio";

const colourControls = [
  { key: "shell", label: "Shell", swatches: SHELLS },
  { key: "phosphor", label: "Phosphor", swatches: PHOSPHORS },
] as const satisfies ReadonlyArray<{
  readonly key: ColourKey;
  readonly label: string;
  readonly swatches: ReadonlyArray<readonly [string, string]>;
}>;

const toggles = [
  { key: "interactive", label: "Follow pointer" },
  { key: "floorShadow", label: "Floor shadow" },
] as const satisfies ReadonlyArray<{ readonly key: ControlKey; readonly label: string }>;
---

<Layout
  title="Studio · Supaterm"
  description="Dress up the Supaterm bolt computer: pick its shell, its phosphor and what its screen shows."
>
  <section class="studio" data-studio>
    <div class="container">
      <div class="studio-grid">
        <div class="stage">
          <div class="stage-computer bolt-computer" data-stage>
            <Image
              src={appIcon}
              alt=""
              width={340}
              height={340}
              densities={[1, 2]}
              format="webp"
              quality={90}
              loading="eager"
            />
          </div>
          <div class="caption" aria-live="polite">
            <h2 data-caption-name>{STATE_COPY.idle.name}</h2>
            <p data-caption-hint>{STATE_COPY.idle.hint}</p>
          </div>
          <div class="screens" role="group" aria-label="Screen">
            {
              BOLT_COMPUTER_STATES.map((state) => (
                <button
                  type="button"
                  class="screen"
                  data-setting="state"
                  data-value={state}
                  aria-pressed={state === "idle" ? "true" : "false"}
                >
                  <span class="screen-thumb bolt-computer" data-thumb={state} />
                  <span>{STATE_COPY[state].name}</span>
                </button>
              ))
            }
          </div>
        </div>

        <aside class="controls" aria-label="Controls">
          {
            colourControls.map(({ key, label, swatches }) => (
              <div class="control">
                <div class="control-head">
                  <span class="control-label">{label}</span>
                  <span class="control-value" data-value-of={key}>
                    {swatches[0][0]}
                  </span>
                </div>
                <div class="swatches" role="group" aria-label={label}>
                  {swatches.map(([name, hex]) => (
                    <button
                      type="button"
                      class="swatch"
                      style={`--swatch:${hex}`}
                      data-setting={key}
                      data-value={hex}
                      aria-label={`${label}: ${name}`}
                      aria-pressed="false"
                    />
                  ))}
                  <label class="swatch swatch-custom">
                    <input type="color" data-setting={key} aria-label={`${label}: custom colour`} />
                  </label>
                </div>
              </div>
            ))
          }

          <div class="control">
            <div class="control-head">
              <span class="control-label">Speed</span>
              <button type="button" class="text-button" data-action="pause">Pause</button>
            </div>
            <div class="segments" role="group" aria-label="Speed">
              {
                SPEEDS.map((speed) => (
                  <button
                    type="button"
                    class="segment"
                    data-setting="speed"
                    data-value={String(speed)}
                    aria-pressed="false"
                  >
                    {speed}×
                  </button>
                ))
              }
            </div>
          </div>

          {
            toggles.map(({ key, label }) => (
              <div class="control">
                <div class="control-head">
                  <span class="control-label">{label}</span>
                </div>
                <div class="segments" role="group" aria-label={label}>
                  <button
                    type="button"
                    class="segment"
                    data-setting={key}
                    data-value="true"
                    aria-pressed="true"
                  >
                    On
                  </button>
                  <button
                    type="button"
                    class="segment"
                    data-setting={key}
                    data-value="false"
                    aria-pressed="false"
                  >
                    Off
                  </button>
                </div>
              </div>
            ))
          }

          <div class="actions">
            <button type="button" class="btn btn-primary" data-action="download">Download PNG</button>
            <button type="button" class="btn btn-ghost" data-action="copy">Copy link</button>
            <button type="button" class="text-button" data-action="reset" hidden>Reset</button>
          </div>

          <p class="credit">
            Drawn on a 2D canvas, adapted from{" "}
            <a href="https://github.com/fayazara/robot-heads" target="_blank" rel="noopener noreferrer"
              >robot-heads</a
            >{" "}
            by Fayaz Ahmed.
          </p>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { startStudio } from "../lib/studio";

  const root = document.querySelector<HTMLElement>("[data-studio]");
  if (root) startStudio(root);
</script>

<style>
  .studio {
    padding: 32px 0 80px;
  }

  .studio-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 32px;
    align-items: start;
  }

  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 72px 24px 24px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: radial-gradient(ellipse 60% 50% at 50% 32%, rgba(255, 255, 255, 0.05), transparent 70%);
  }

  .stage-computer {
    width: clamp(220px, 26vw, 340px);
  }

  .stage-computer:global(.is-interactive) { cursor: pointer; }

  .caption {
    min-height: 56px;
    text-align: center;
  }

  .caption h2 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .caption p {
    margin-top: 4px;
    color: var(--fg-muted);
    font-size: 14px;
  }

  .screens {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    width: 100%;
    max-width: 520px;
  }

  .screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px 8px 8px;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--fg-muted);
    font-size: 13px;
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }

  .screen:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .screen[aria-pressed="true"] {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.04);
    color: var(--fg);
  }

  .screen-thumb {
    width: 48px;
  }

  .controls {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 20px;
  }

  .control-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .control-label {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .control-value {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .swatch {
    position: relative;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px var(--border-strong);
    transition: box-shadow 0.15s ease;
  }

  .swatch[aria-pressed="true"],
  .swatch-custom[data-active="true"] {
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--fg);
  }

  .swatch-custom {
    overflow: hidden;
    background: var(
      --custom,
      conic-gradient(from 90deg, #ff6a6a, #ffd36a, #7dff9a, #6adaff, #da6aff, #ff6a6a)
    );
    cursor: pointer;
  }

  .swatch-custom input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    cursor: pointer;
  }

  .swatch-custom:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .segments {
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
  }

  .segment {
    padding: 7px 0;
    border-radius: 7px;
    color: var(--fg-muted);
    font-size: 13px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .segment:hover { color: var(--fg); }

  .segment[aria-pressed="true"] {
    background: rgba(255, 255, 255, 0.1);
    color: var(--fg);
  }

  .text-button {
    color: var(--fg-muted);
    font-size: 13px;
  }

  .text-button:hover { color: var(--fg); }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .credit {
    color: var(--fg-dim);
    font-size: 12px;
  }

  .credit a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .studio-grid { grid-template-columns: 1fr; }
    .controls { position: static; }
  }

  @media (max-width: 520px) {
    .stage { padding: 72px 12px 20px; }
    .screens { gap: 6px; }
  }
</style>
