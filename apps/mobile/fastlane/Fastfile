require "timeout"

def required_store_env(name)
  value = ENV[name]
  UI.user_error!("#{name} is required") if value.to_s.empty?
  value
end

def store_api_key
  app_store_connect_api_key(
    key_id: required_store_env("APPLE_API_KEY_ID"),
    issuer_id: required_store_env("APPLE_API_ISSUER"),
    key_content: required_store_env("APPLE_API_KEY"),
    duration: 1200
  )
end

platform :ios do
  desc "Submit the exact uploaded build to the public TestFlight beta"
  lane :external_beta do
    version = required_store_env("MOBILE_VERSION")
    build_number = required_store_env("MOBILE_BUILD_NUMBER")
    identifier = required_store_env("MOBILE_APPLICATION_ID")
    api_key = store_api_key
    app = Spaceship::ConnectAPI::App.find(identifier)
    UI.user_error!("App Store Connect application was not found") unless app
    group = app.get_beta_groups.find { |candidate| candidate.name == "Supaterm Public Beta" && !candidate.is_internal_group }
    UI.user_error!("The Supaterm Public Beta external group was not found") unless group
    require "fastlane_core/build_watcher"
    build = FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
      app_id: app.id, platform: "IOS", app_version: version, build_version: build_number,
      timeout_duration: 2700, return_spaceship_testflight_build: false,
      wait_for_build_beta_detail_processing: true
    )
    state = build.build_beta_detail.external_build_state
    eligible_states = %w[READY_FOR_BETA_SUBMISSION WAITING_FOR_BETA_REVIEW IN_BETA_REVIEW BETA_APPROVED READY_FOR_BETA_TESTING IN_BETA_TESTING]
    UI.user_error!("TestFlight build #{version} (#{build_number}) cannot be distributed (state=#{state})") if build.expired || !eligible_states.include?(state)
    upload_to_testflight(
      api_key: api_key, app_identifier: identifier, app_platform: "ios",
      app_version: version, build_number: build_number,
      distribute_only: true, wait_processing_timeout_duration: 2700,
      distribute_external: true, groups: [group.id], submit_beta_review: true,
      notify_external_testers: true, reject_build_waiting_for_review: false,
      expire_previous_builds: false,
      changelog: ENV.fetch("MOBILE_RELEASE_NOTES", "Test the latest Supaterm conversations, code review, and remote connections.")
    )
  end

  desc "Upload screenshots and submit the exact processed build for App Store review"
  lane :review do
    version = required_store_env("MOBILE_VERSION")
    build_number = required_store_env("MOBILE_BUILD_NUMBER")
    identifier = required_store_env("MOBILE_APPLICATION_ID")
    api_key = store_api_key
    app = Spaceship::ConnectAPI::App.find(identifier)
    UI.user_error!("App Store Connect application was not found") unless app
    build = Timeout.timeout(2700) do
      loop do
        candidate = Spaceship::ConnectAPI::Build.all(
          app_id: app.id, version: version, build_number: build_number, platform: "IOS"
        ).first
        UI.user_error!("Apple build #{version} (#{build_number}) has expired") if candidate&.expired
        break candidate if candidate&.processing_state == "VALID"
        UI.user_error!("Apple rejected processing build #{version} (#{build_number})") if
          candidate && %w[FAILED INVALID].include?(candidate.processing_state)
        UI.message("Waiting for Apple to process #{version} (#{build_number})")
        sleep(30)
      end
    end
    existing = app.get_app_store_versions(
      filter: {versionString: version, platform: "IOS"}
    ).first
    submitted_states = %w[WAITING_FOR_REVIEW IN_REVIEW ACCEPTED PENDING_DEVELOPER_RELEASE PENDING_APPLE_RELEASE PROCESSING_FOR_DISTRIBUTION READY_FOR_DISTRIBUTION REPLACED_WITH_NEW_VERSION READY_FOR_SALE]
    if existing && submitted_states.include?(existing.app_version_state)
      existing_build = existing.get_build
      if existing_build&.id == build.id
        UI.success("#{version} (#{build_number}) has already been submitted")
        next
      end
      UI.user_error!("This App Store version already uses a different build (state=#{existing.app_version_state}, build_id=#{existing_build&.id})") unless existing.app_version_state == "WAITING_FOR_REVIEW"
    end
    if existing&.app_version_state == "READY_FOR_REVIEW"
      UI.user_error!("The ready submission uses a different iOS build") unless existing.get_build&.id == build.id
      submission = app.get_ready_review_submission(platform: "IOS")
      UI.user_error!("The ready iOS review submission was not found") unless submission
      items = Spaceship::ConnectAPI::ReviewSubmissionItem.all(
        review_submission_id: submission.id, includes: "appStoreVersion"
      )
      unless items.length == 1 && items.first.app_store_version&.id == existing.id
        UI.user_error!("The ready iOS submission contains other review items")
      end
      submission.submit_for_review
      UI.success("Resumed review submission for #{version} (#{build_number})")
      next
    end
    submission_options = {
      api_key: api_key,
      app_identifier: identifier,
      app_version: version,
      build_number: build_number,
      skip_binary_upload: true,
      screenshots_path: required_store_env("MOBILE_STORE_ASSETS"),
      metadata_path: File.expand_path("metadata", __dir__),
      release_notes: {"en-US" => ENV.fetch("MOBILE_RELEASE_NOTES", "This update includes the latest Supaterm app changes.")},
      overwrite_screenshots: true,
      force: true,
      reject_if_possible: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false
    }
    begin
      upload_to_app_store(**submission_options)
    rescue => error
      raise unless error.message.include?("Failed verification of all screenshots deleted")
      upload_to_app_store(**submission_options.merge(skip_screenshots: true))
    end
  end
end

platform :android do
  desc "Upload screenshots and promote the exact internal build to production review"
  lane :review do
    identifier = required_store_env("MOBILE_APPLICATION_ID")
    version_code = Integer(required_store_env("MOBILE_VERSION_CODE"))
    key_path = required_store_env("GOOGLE_PLAY_JSON_KEY_PATH")
    production_codes = google_play_track_version_codes(
      package_name: identifier, json_key: key_path, track: "production"
    )
    if production_codes.include?(version_code)
      release = Supply::Reader.new.track_release_summaries.find do |candidate|
        Array(candidate.active_artifacts).any? { |artifact| artifact.version_code == version_code }
      end
      submitted_states = %w[RELEASE_LIFECYCLE_STATE_IN_REVIEW RELEASE_LIFECYCLE_STATE_APPROVED_NOT_PUBLISHED RELEASE_LIFECYCLE_STATE_PUBLISHED]
      if submitted_states.include?(release&.release_lifecycle_state)
        UI.success("Android build #{version_code} has already been submitted")
        next
      end
      editable_states = %w[RELEASE_LIFECYCLE_STATE_DRAFT RELEASE_LIFECYCLE_STATE_NOT_SENT_FOR_REVIEW RELEASE_LIFECYCLE_STATE_NOT_APPROVED]
      unless editable_states.include?(release&.release_lifecycle_state)
        UI.user_error!("Google Play did not report a usable review state for build #{version_code}")
      end
    end
    upload_to_play_store_review(
      package_name: identifier,
      json_key: key_path,
      metadata_path: required_store_env("MOBILE_STORE_ASSETS"),
      version_code: version_code,
      track: production_codes.include?(version_code) ? "production" : "internal",
      track_promote_to: "production",
      track_promote_release_status: "completed",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      sync_image_upload: true,
      changes_not_sent_for_review: false,
      rescue_changes_not_sent_for_review: false
    )
  end
end
