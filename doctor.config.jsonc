{
  "$schema": "https://react.doctor/schema/config.json",
  // Scans stay on this machine: no score upload and no dependency lookups.
  "noScore": true,
  "supplyChain": { "enabled": false },
  "projects": ["*"],
  "ignore": { "files": ["**/.generated/**"] },
  // The pre-commit hook reports only findings a commit introduces, so a rule stays on even
  // where older code trips it. A rule is off only when oxlint already owns it, or when
  // correct code written the way this codebase writes it would trip it on most commits.
  "rules": {
    // Size and Fast Refresh opinions. None changes what ships.
    "react-doctor/no-high-complexity-react-function": "off",
    "react-doctor/no-giant-component": "off",
    "react-doctor/only-export-components": "off",

    // oxlint enforces these as errors (vite.config.ts). A second copy would need a second
    // suppression on every reasoned exception.
    "react-hooks-js/set-state-in-effect": "off",
    "react-hooks-js/refs": "off",
    "react-hooks-js/purity": "off",
    "react-doctor/no-array-index-as-key": "off",
    // oxlint checks dependency lists. This rule's other claim, that a dependency is rebuilt
    // every render, is false under React Compiler.
    "react-doctor/exhaustive-deps": "off",

    // The lint config already declines this advice (no-await-in-loop, prefer-set-has).
    "react-doctor/async-await-in-loop": "off",
    "react-doctor/js-set-map-lookups": "off",

    // Atom commands resolve to a result and never reject, so no flag can be stranded.
    "react-doctor/no-loading-flag-reset-outside-finally": "off",
    // Base UI `render={<a />}` receives its children at runtime.
    "react-doctor/anchor-has-content": "off",
    // Does not follow unsubscribe lists, cleanup arrays, or terminated workers.
    "react-doctor/effect-needs-cleanup": "off",
    // Every screen pads its scroll content by the safe-area insets.
    "react-doctor/rn-scrollview-dynamic-padding": "off",
  },
}
